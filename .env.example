# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# On Vercel these go in Project Settings -> Environment Variables instead.

# Canonical origin, no trailing slash. Used for metadata, canonical tags, the
# sitemap and robots. Without it, SEO falls back to SITE_URL in
# src/content/site.ts.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Contact form (Resend, https://resend.com) --------------------------------
# Both of the next two are required. With either missing the form does not
# pretend to send: it shows a visible error pointing at the email address and
# logs a warning.

# From https://resend.com/api-keys. Starts with "re_".
RESEND_API_KEY=

# The sending address. Two options:
#   onboarding@resend.dev      works with no DNS setup, but Resend will only
#                              deliver to the address that owns the account
#   you@your-verified-domain   any recipient, once the domain is verified at
#                              https://resend.com/domains
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Optional. Where enquiries land. Defaults to person.email in
# src/content/site.ts. While using onboarding@resend.dev this has to match the
# address the Resend account is registered with.
# CONTACT_TO_EMAIL=you@example.com
