# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. Real values stay local; the template is deliberately committed so
# the required variables are discoverable when setting the project up on Vercel.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# iCloud sync duplicates. ~/Desktop is synced, and conflicts land as "name 2.ext"
# alongside the original. They break tsc when they appear under .next/types, and
# a stale "nav 2.tsx" once shipped a component two versions behind.
*\ [0-9].*
*\ [0-9]/

# Machine-local Claude Code permissions. launch.json is shared project config
# and stays tracked.
.claude/settings.local.json
